# Development (npm run dev) — Vite proxies /api to VITE_DEV_API_TARGET
VITE_API_URL=/api
VITE_ASSET_URL=
VITE_DEV_API_TARGET=http://localhost:5000

# Production (npm run build) — put these in .env.production instead:
# VITE_API_URL=https://your-api-domain.com/api
# VITE_ASSET_URL=https://your-api-domain.com
# Cloudflare Turnstile site key. Leave blank to render a dev-only stub instead.
VITE_TURNSTILE_SITE_KEY=

# Stripe publishable key.
VITE_STRIPE_PUBLISHABLE_KEY=
